{
  "manifest_version": 3,
  "name": "OpenClaw Hybrid Pro",
  "version": "1.1",
  "description": "AI-powered social media automation with local security silos.",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}